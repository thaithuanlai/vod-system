# VOD System - Environment Variables Template
# Copy file này thành .env và điền values thực tế
# KHÔNG commit file .env lên GitHub 

# API GATEWAY
PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
USER_SERVICE_URL=http://user-service:3001
UPLOAD_SERVICE_URL=http://upload-service:3002
VIDEO_SERVICE_URL=http://video-service:3003
PROCESSING_SERVICE_URL=http://processing-service:3004
STREAMING_SERVICE_URL=http://streaming-service:3005
NOTIFICATION_SERVICE_URL=http://notification-service:3006

# USER SERVICE
USER_SERVICE_PORT=3001
DATABASE_URL=postgresql://vod_admin:PASSWORD@HOST:5432/vod_users
# Production: postgresql://vod_admin:PASSWORD@/vod_users?host=/cloudsql/PROJECT:REGION:INSTANCE

# UPLOAD SERVICE
UPLOAD_SERVICE_PORT=3002
MAX_FILE_SIZE_MB=500

# VIDEO SERVICE
VIDEO_SERVICE_PORT=3003

# PROCESSING SERVICE
PROCESSING_SERVICE_PORT=3004

# STREAMING SERVICE
STREAMING_SERVICE_PORT=3005

# NOTIFICATION SERVICE
NOTIFICATION_SERVICE_PORT=3006

# GOOGLE CLOUD PLATFORM
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=vod-videos-your-project-id
GCS_RAW_VIDEO_FOLDER=raw-videos
GCS_HLS_OUTPUT_FOLDER=hls-outputs
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
# Production trên Cloud Run: để trống, dùng Service Account mặc định

# RABBITMQ
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672
RABBITMQ_QUEUE_VIDEO_PROCESSING=video-processing
RABBITMQ_QUEUE_VIDEO_PROCESSED=video-processed

# NODE
NODE_ENV=development