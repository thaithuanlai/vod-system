# ════════════════════════════════════════════════════
# VOD System — Local Development Environment
# ════════════════════════════════════════════════════

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=dev-local-secret-key-please-change-in-production

# ─── PostgreSQL (local container) ────────────────────
POSTGRES_PASSWORD=vod_local_password

# ─── RabbitMQ ────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# ─── Google Cloud (điền sau khi có billing) ──────────
GCP_PROJECT_ID=vod-system-2025
GCS_BUCKET_NAME=vod-videos-vod-system-2025
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# ─── CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
